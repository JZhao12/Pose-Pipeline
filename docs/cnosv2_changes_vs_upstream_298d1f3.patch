+#!/bin/bash
+set -euo pipefail
+
+OBJ_NAME=${1:-}
+IMG_NAME=${2:-"000000"}
+if [ -z "$OBJ_NAME" ]; then
+    echo "用法: bash ./src/scripts/inference_pipeline.sh <物体名称> [图片名称, 默认000000]" >&2
